# Copy to production.env on the deployment host. production.env is ignored by Git.
PUBLIC_HOST=chat.example.com
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Production requires registry-verified digests, not tags or local image IDs.
BACKEND_IMAGE=ghcr.io/example/p2p-chat-backend@sha256:replace-with-registry-digest
CADDY_IMAGE=docker.io/library/caddy@sha256:replace-with-registry-digest
POSTGRES_IMAGE=docker.io/library/postgres@sha256:replace-with-registry-digest

POSTGRES_DB=p2p_chat
POSTGRES_USER=p2p_chat
POSTGRES_PASSWORD=replace-with-at-least-20-random-characters
JWT_SECRET=replace-with-base64-encoded-random-32-byte-secret
PUSH_TOKEN_ENCRYPTION_KEYS=v1=replace-with-base64-encoded-random-32-byte-key
WEBSOCKET_ALLOWED_ORIGINS=https://chat.example.com

# Used only by scripts/run-production-monitor.ps1 on the monitoring host.
# Keep the bearer token out of scheduler command lines and service definitions.
PRODUCTION_ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/p2p-chat
PRODUCTION_ALERT_BEARER_TOKEN=

PUSH_DELIVERY_ENABLED=false
FCM_ENABLED=false
FCM_PROJECT_ID=
