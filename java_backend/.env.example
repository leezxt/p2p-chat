POSTGRES_DB=p2p_chat
POSTGRES_USER=p2p_chat
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/p2p_chat
DB_USERNAME=p2p_chat
DB_PASSWORD=replace-with-the-same-local-development-password
JWT_SECRET=replace-with-base64-encoded-random-32-byte-secret
PUSH_TOKEN_ENCRYPTION_KEYS=v1=replace-with-base64-encoded-random-32-byte-key
LOCAL_DEV_AUTH_KEY=replace-with-a-random-local-development-key
PUSH_DELIVERY_ENABLED=false
PUSH_DELIVERY_BATCH_SIZE=50
PUSH_DELIVERY_POLL_DELAY=PT5S
FCM_ENABLED=false
FCM_PROJECT_ID=
# Host execution only. Docker deployments should mount the credential file or use workload identity.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
